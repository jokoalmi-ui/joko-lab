#!/usr/bin/env bash
# router-cron.sh — Política de decisión de IA para Joko Lab
# Actualiza el especialista externo según la franja horaria.
# El modelo principal (Ollama) nunca cambia.
#
# Franja 03:00-12:00 → Gemini como especialista externo
# Franja 12:00-03:00 → DeepSeek como especialista externo
#
# Instalado en crontab:
#   0 3 * * * /home/jokoalmi/hermes-lab/scripts/router-cron.sh
#   0 12 * * * /home/jokoalmi/hermes-lab/scripts/router-cron.sh

set +e

LOG="/home/jokoalmi/hermes-lab/logs/router-modelo.log"
PROVIDER_FILE="/tmp/current-provider.txt"
HORA=$(date +%H | sed 's/^0//')

echo "===== router-cron.sh ejecutado: $(date) =====" >> "$LOG"

if [ "$HORA" -ge 3 ] && [ "$HORA" -lt 12 ]; then
    # Franja 03-12 → Gemini como especialista externo
    echo "Franja 03-12 → cambiando especialista a Gemini" >> "$LOG"

    # Actualizar fallback_providers (respaldo automático si Ollama falla)
    python3 -c "
import yaml, os
path = os.path.expanduser('~/.hermes/config.yaml')
with open(path) as f: cfg = yaml.safe_load(f)
cfg['fallback_providers'] = [{'provider': 'gemini', 'model': 'gemini-3.1-flash-lite'}]
for t in ['vision', 'web_extract', 'compression']:
    if t in cfg.get('auxiliary', {}):
        cfg['auxiliary'][t]['provider'] = 'gemini'
        cfg['auxiliary'][t]['model'] = 'gemini-3.1-flash-lite'
with open(path, 'w') as f: yaml.dump(cfg, f, default_flow_style=False, allow_unicode=True, width=120)
" 2>> "$LOG"

    # Estado para scripts que aún lean el archivo legacy
    echo "gemini" > "$PROVIDER_FILE"
    echo "gemini-3.1-flash-lite" >> "$PROVIDER_FILE"
    echo "https://generativelanguage.googleapis.com/v1beta" >> "$PROVIDER_FILE"

    echo "✓ Especialista: Gemini (gemini-3.1-flash-lite)" >> "$LOG"

else
    # Franja 12-03 → DeepSeek como especialista externo
    echo "Franja normal → cambiando especialista a DeepSeek" >> "$LOG"

    # Actualizar fallback_providers
    python3 -c "
import yaml, os
path = os.path.expanduser('~/.hermes/config.yaml')
with open(path) as f: cfg = yaml.safe_load(f)
cfg['fallback_providers'] = [{'provider': 'deepseek', 'model': 'deepseek-v4-flash'}]
for t in ['vision', 'web_extract', 'compression']:
    if t in cfg.get('auxiliary', {}):
        cfg['auxiliary'][t]['provider'] = 'deepseek'
        cfg['auxiliary'][t]['model'] = 'deepseek-v4-flash'
with open(path, 'w') as f: yaml.dump(cfg, f, default_flow_style=False, allow_unicode=True, width=120)
" 2>> "$LOG"

    # Estado para scripts legacy
    echo "deepseek" > "$PROVIDER_FILE"
    echo "deepseek-v4-flash" >> "$PROVIDER_FILE"
    echo "https://api.deepseek.com/v1" >> "$PROVIDER_FILE"

    echo "✓ Especialista: DeepSeek (deepseek-v4-flash)" >> "$LOG"
fi

echo "===== fin router-cron.sh =====" >> "$LOG"
echo "" >> "$LOG"
exit 0
